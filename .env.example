# Claude API key (console.anthropic.com). Without it the app runs in demo mode.
ANTHROPIC_API_KEY=
# TMDB read access token (themoviedb.org > Settings > API). Gives posters + verified directors.
TMDB_READ_TOKEN=
# Or the older v3 API key instead of the token:
TMDB_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
PORT=3000
